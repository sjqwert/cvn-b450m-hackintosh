<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cn.laobamac.gpu-lab</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/usr/local/bin/gpu-lab-guard.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>GPU_LAB_DELAY</key>
        <string>30</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>0</integer>
    <key>StandardOutPath</key>
    <string>/var/log/gpu-lab.out</string>
    <key>StandardErrorPath</key>
    <string>/var/log/gpu-lab.err</string>
</dict>
</plist>
